# Database: local mongod while developing; MongoDB Atlas in production.
MONGODB_URI="mongodb://127.0.0.1:27017/furniture-store"

# Admin sign-in: a 6-digit access code (avoid 123456, birthdays, repeats), and
# the secret that signs its session cookie. `scripts/new-shop.ts` generates both.
ADMIN_ACCESS_CODE=""
SESSION_SECRET=""

# Stripe (https://dashboard.stripe.com/apikeys). Use test keys while developing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Currency for every price (ISO code: GBP, USD, EUR, NGN…). Default GBP.
# Set it before the shop takes orders.
NEXT_PUBLIC_CURRENCY="GBP"

# The shop's name and the business details UK law requires on the site:
# legal name, email (and address/company number if you have them).
# Everything else the shop says is in Admin → Shop settings.
NEXT_PUBLIC_STORE_NAME=""
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=""
NEXT_PUBLIC_COMPANY_NUMBER=""
NEXT_PUBLIC_VAT_NUMBER=""
NEXT_PUBLIC_BUSINESS_ADDRESS=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""

# Optional: address lists at checkout via Ideal Postcodes (paid per lookup).
# Without it, the postcode is still checked (postcodes.io) and customers type the street address.
IDEAL_POSTCODES_API_KEY=""

# Customer emails: ZeptoMail API (Send Mail token from your mail agent).
ZOHO_ZEPTOMAIL_TOKEN=""
ZOHO_ZEPTOMAIL_FROM=""
ZOHO_ZEPTOMAIL_FROM_NAME=""
# ZOHO_ZEPTOMAIL_API_URL="https://api.zeptomail.eu/v1.1/email"   # EU accounts only
# Encrypts secrets stored in the database (ordering inbox password). Long random string.
SETTINGS_ENCRYPTION_KEY=""
# Protects /api/cron/mail (scheduled inbox check).
CRON_SECRET=""

# Zoho Mail outgoing webhook: secret key in the webhook URL (any long random string).
ZOHO_MAIL_WEBHOOK_KEY=""
